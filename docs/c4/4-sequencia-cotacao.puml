@startuml
title FreteJá — Nível 4 (código): sequência de uma cotação

skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
hide footbox
skinparam sequence {
  ParticipantBackgroundColor #FDFCFA
  ParticipantBorderColor #14213D
  LifeLineBorderColor #9AA3B2
  ArrowColor #14213D
  GroupBorderColor #9AA3B2
}

actor "Operador\nda loja" as op
participant "FreteController" as ctl
participant "ComparadorDeFrete" as cmp
participant "RegistroDePlugins" as reg
box "Cache" #E6EEF7
participant "CotadorDeTransportadora\n(@Cacheable)" as cot
database "Redis" as redis
end box
box "Circuit breaker" #FBEBDD
participant "ExecutorIsolado" as exe
participant "CircuitBreaker\n(Resilience4j)" as cb
end box
participant "Plugin\n(Transportadora)" as plg

op -> ctl : POST /api/cotacoes (envio)
ctl -> cmp : comparar(envio)
cmp -> reg : listar()
reg --> cmp : transportadoras carregadas

loop para cada transportadora, em paralelo (uma thread virtual cada)
  cmp -> cot : cotar(plugin, envio)
  cot -> redis : buscar "id:envio"
  alt está no cache
    redis --> cot : cotação guardada
    note right of cot : origem CACHE\nplugin nem é chamado
  else não está no cache
    cot -> exe : cotar(plugin, envio)
    exe -> cb : executeSupplier(chamada)
    alt circuito ABERTO
      cb --> exe : CallNotPermittedException
      exe --> cot : PluginIndisponivelException
      note right of cot : INDISPONIVEL na hora\n(não vai para o cache)
    else circuito FECHADO ou MEIO-ABERTO
      cb -> plg : cotar(envio)\n(via ExecutorIsolado, em outra thread, até 2 s)
      alt respondeu a tempo
        plg --> cb : CotacaoDeFrete
        note right of cb : conta sucesso
        cb --> exe : CotacaoDeFrete
        exe --> cot : CotacaoDeFrete
        cot -> redis : guardar "id:envio" (5 min)
      else exceção ou mais de 2 s
        note right of cb : conta falha\n(50% em 3 chamadas abre o circuito)
        cb --> exe : FalhaDePluginException
        exe --> cot : PluginIndisponivelException
        note right of cot : INDISPONIVEL\n(não vai para o cache)
      end
    end
  end
  cot --> cmp : cotação da transportadora
end

cmp -> cmp : ordenar (cotadas, não atende, indisponíveis)
cmp --> ctl : cotações ordenadas
ctl --> op : comparação + origem de cada linha + tempo
@enduml
